import { chromium } from 'playwright';
const BASE = 'http://localhost:5173';
const PHONE = '+256700000011';
const SS = 'docs/audits/2026-08-23/screenshots/branch';
const b = await chromium.launch({ headless: true });

// login once at desktop, save state
const lctx = await b.newContext({ viewport: { width: 1440, height: 900 } });
const lp = await lctx.newPage();
await lp.goto(BASE + '/', { waitUntil: 'domcontentloaded' });
await lp.waitForTimeout(1000);
let tel = lp.locator('input[type="tel"]:visible').first();
await tel.waitFor({ state: 'visible', timeout: 8000 });
await tel.fill(PHONE);
await lp.getByRole('button', { name: /send verification code|send code|continue/i }).first().click();
await lp.locator('input[name="otp-0"]').waitFor({ state: 'visible', timeout: 8000 });
for (let i = 0; i < 6; i++) await lp.locator(`input[name="otp-${i}"]`).fill('123456'[i]);
await lp.getByRole('button', { name: /verify/i }).first().click();
await lp.waitForURL(/\/dashboard/, { timeout: 20000 });
const state = await lctx.storageState();
await lctx.close();

const norm = (s) => (s||'').replace(/\s+/g,' ').trim();
async function visit(vp, name, route, tag) {
  const ctx = await b.newContext({ viewport: vp, storageState: state });
  const p = await ctx.newPage();
  const errs = [];
  p.on('console', m => { if (m.type()==='error') errs.push(norm(m.text()).slice(0,140)); });
  p.on('pageerror', e => errs.push('PAGEERR '+norm(String(e)).slice(0,140)));
  await p.goto(BASE + route, { waitUntil: 'domcontentloaded' });
  await p.waitForTimeout(2600);
  const url = p.url();
  const txt = norm(await p.evaluate(()=>document.body.innerText)).slice(0, 900);
  await p.screenshot({ path: `${SS}/${tag}-${vp.width}.png`, fullPage: true });
  console.log(`\n### [${name} ${vp.width}] route=${route} -> url=${url}`);
  console.log('TEXT:', txt);
  if (errs.length) console.log('CONSOLE_ERRORS:', JSON.stringify([...new Set(errs)]));
  await ctx.close();
}

const DESK = { width: 1440, height: 900 };
await visit(DESK, 'overview', '/dashboard', 'd-overview');
await visit(DESK, 'attention-dormant', '/dashboard/attention/dormant', 'd-attention-dormant');
await visit(DESK, 'attention-overdue', '/dashboard/attention/overdue', 'd-attention-overdue');
await visit(DESK, 'agents', '/dashboard/agents', 'd-agents');
await visit(DESK, 'agent-detail', '/dashboard/agents/a-087', 'd-agent-detail');
await visit(DESK, 'agent-subscribers', '/dashboard/agents/a-087/subscribers', 'd-agent-subs');
await visit(DESK, 'commissions', '/dashboard/commissions', 'd-commissions');
await visit(DESK, 'analytics', '/dashboard/analytics', 'd-analytics');
await visit(DESK, 'reports-redirect', '/dashboard/reports', 'd-reports');
await visit(DESK, 'support', '/dashboard/support', 'd-support');
await visit(DESK, 'settings', '/dashboard/settings', 'd-settings');
await visit(DESK, 'bogus', '/dashboard/nonexistent-xyz', 'd-bogus');
await b.close();
