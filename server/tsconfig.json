{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    // A25-006 — the closest dependency-free equivalent to ESLint's
    // no-unused-vars for this TS surface: eslint-plugin-@typescript-eslint
    // isn't installed (no typescript-eslint in package-lock.json anywhere in
    // the tree — verified 2026-08-25) and this task's guardrails forbid
    // adding a dependency to get it. tsc's own noUnusedLocals/
    // noUnusedParameters catch the same class of dead code using only the
    // `typescript` package already in devDependencies. Verified clean
    // against the real build:api output before enabling (zero new errors).
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "rootDir": "..",
    "outDir": "../dist-server",
    "types": ["node"]
  },
  "include": ["../api/**/*.ts", "./**/*.ts"],
  "exclude": [
    // Sync-conflict copies ("foo 2.ts") from the Desktop folder sync.
    // NOT "[0-9]": TypeScript exclude globs support only *, ? and **, never
    // character classes, so a [0-9] pattern silently matches nothing.
    "**/* ?.*",
    "**/* ??.*",
    "../node_modules/**",
    "../dist/**",
    "../api/**/*.test.ts",
    "../api/**/*.spec.ts",
    "./**/*.test.ts"
  ]
}
